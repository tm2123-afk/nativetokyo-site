---
const tags = [
  '#第一印象',
  '#また会いたいと思われる',
  '#見せ方の設計',
  '#AI時代の人間力',
  '#非言語コミュニケーション',
  '#営業の伝わり方',
  '#管理職研修',
  '#採用面接の印象',
  '#プレゼンスマネジメント',
];
const looped = [...tags, ...tags];
---

<div class="hashtag-marquee">
  <div class="hashtag-track">
    {looped.map((tag, i) => (
      <span class="hashtag-item">
        <span class="hashtag-text">{tag}</span>
        <span class="hashtag-dot" aria-hidden="true"></span>
      </span>
    ))}
  </div>
</div>

<style>
  .hashtag-marquee {
    overflow: hidden;
    background: var(--color-paper);
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    padding: 22px 0;
  }
  .hashtag-track {
    display: flex;
    width: max-content;
    gap: 0;
    animation: hashtag-scroll 26s linear infinite;
  }
  .hashtag-marquee:hover .hashtag-track {
    animation-play-state: paused;
  }

  .hashtag-item {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  /* 太字・大きめサイズで力強さを出す。ゴシックではなく明朝の極太で
     "格" のブランド言語を保ったままインパクトを出す */
  .hashtag-text {
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(22px, 3vw, 34px);
    letter-spacing: 0.01em;
    color: var(--color-ink);
    padding: 0 28px;
    transition: color 0.2s ease;
  }
  .hashtag-item:nth-child(odd) .hashtag-text {
    /* 交互にマゼンタを差し込んでリズムを作る */
    color: var(--color-magenta);
    -webkit-text-stroke: 0;
  }

  .hashtag-dot {
    width: 10px;
    height: 10px;
    background: var(--color-navy);
    display: inline-block;
    flex-shrink: 0;
    transform: rotate(45deg);
  }

  @keyframes hashtag-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hashtag-track { animation: none; }
  }
</style>
