---
interface Props {
  quote: string;
  attribution?: string;
}
const { quote, attribution } = Astro.props;
---

<section class="magenta-band" data-reveal>
  <div class="mb-insignia" aria-hidden="true">
    <div class="mb-ring mb-ring-1"></div>
    <div class="mb-ring mb-ring-2"></div>
    <div class="mb-ring mb-ring-3"></div>
  </div>

  <div class="relative z-10 px-6 md:px-16 py-24 md:py-32 max-w-4xl">
    <p class="font-mincho font-bold text-[clamp(26px,3.6vw,42px)] leading-[1.7] text-paper">
      「{quote}」
    </p>
    {attribution && <p class="mt-8 label text-paper/70">{attribution}</p>}
  </div>
</section>

<style>
  .magenta-band {
    position: relative;
    overflow: hidden;
    background: var(--color-magenta);
  }
  .mb-insignia {
    position: absolute;
    top: 50%;
    right: -120px;
    transform: translateY(-50%);
    width: 480px;
    height: 480px;
    pointer-events: none;
  }
  .mb-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(250, 250, 247, 0.25);
  }
  .mb-ring-2 { inset: 70px; border-color: rgba(250, 250, 247, 0.35); }
  .mb-ring-3 { inset: 150px; border: 2px solid var(--color-navy); opacity: 0.55; }
</style>
