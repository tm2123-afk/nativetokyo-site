---
// 格章リップルアニメーション
// 中心から同心円が外に広がりフェードアウト
// 白金色(#E8E0CC)、opacity 0.08〜0.15、3〜4本が時間差で繰り返す、周期20秒
---

<div class="hero-ripple" aria-hidden="true">
  <svg
    viewBox="0 0 1400 900"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
    class="ripple-svg"
  >
    <!-- リップル中心を画面右側に配置（テキストと重ならない位置） -->
    <g class="ripple-group" style="transform-origin: 1050px 450px;">
      <!-- リップル1 -->
      <circle
        class="ripple-circle ripple-1"
        cx="1050"
        cy="450"
        r="50"
        fill="none"
        stroke="#E8E0CC"
        stroke-width="1"
      />
      <!-- リップル2 -->
      <circle
        class="ripple-circle ripple-2"
        cx="1050"
        cy="450"
        r="50"
        fill="none"
        stroke="#E8E0CC"
        stroke-width="1"
      />
      <!-- リップル3 -->
      <circle
        class="ripple-circle ripple-3"
        cx="1050"
        cy="450"
        r="50"
        fill="none"
        stroke="#E8E0CC"
        stroke-width="1"
      />
      <!-- リップル4 -->
      <circle
        class="ripple-circle ripple-4"
        cx="1050"
        cy="450"
        r="50"
        fill="none"
        stroke="#E8E0CC"
        stroke-width="1"
      />
    </g>
  </svg>
</div>

<style is:global>
  .hero-ripple {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ripple-svg {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .ripple-circle {
    opacity: 0;
    transform-origin: 1050px 450px;
    animation: ripple-expand 20s ease-out infinite;
  }

  .ripple-1 {
    animation-delay: 0s;
  }
  .ripple-2 {
    animation-delay: 5s;
  }
  .ripple-3 {
    animation-delay: 10s;
  }
  .ripple-4 {
    animation-delay: 15s;
  }

  @keyframes ripple-expand {
    0% {
      r: 50;
      opacity: 0.15;
      stroke-width: 1;
    }
    50% {
      opacity: 0.10;
    }
    100% {
      r: 900;
      opacity: 0;
      stroke-width: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ripple-circle {
      animation: none;
      opacity: 0.08;
      r: 400;
    }
  }
</style>
