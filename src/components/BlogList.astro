---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  lastPage: number;
}

const { posts, currentPage, lastPage } = Astro.props;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 1ページ目は /blog/、2ページ目以降は /blog/page/2/ の形にする
const pageUrl = (n: number) => (n === 1 ? '/blog/' : `/blog/page/${n}/`);
const pages = Array.from({ length: lastPage }, (_, i) => i + 1);
---

<ul class="relative z-10 max-w-3xl border-t border-line" data-reveal-group>
  {posts.map((post) => (
    <li class="border-b border-line" data-reveal>
      <a href={`/blog/${post.id}/`} class="flex gap-6 py-8 group transition-transform hover:translate-x-2">
        {post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            class="w-28 h-28 sm:w-36 sm:h-36 object-cover shrink-0 border border-line"
            width="144" height="144" loading="lazy"
          />
        )}
        <div class="min-w-0">
          <time datetime={post.data.pubDate.toISOString()} class="text-xs text-ink/50 tracking-wide">
            {fmt(post.data.pubDate)}
          </time>
          <h2 class="font-mincho font-bold text-lg md:text-xl text-navy mt-3 mb-3 group-hover:text-magenta transition-colors">
            {post.data.title}
          </h2>
          <p class="text-sm leading-loose text-ink/70">{post.data.description}</p>
        </div>
      </a>
    </li>
  ))}
</ul>

{lastPage > 1 && (
  <nav aria-label="ブログのページ送り" class="relative z-10 max-w-3xl mt-12 flex flex-wrap items-center gap-2 text-sm">
    {currentPage > 1 && (
      <a href={pageUrl(currentPage - 1)} rel="prev" class="px-4 py-2 border border-line text-navy hover:text-magenta transition-colors">← 前へ</a>
    )}
    {pages.map((n) =>
      n === currentPage ? (
        <span aria-current="page" class="px-4 py-2 border border-navy bg-navy text-white">{n}</span>
      ) : (
        <a href={pageUrl(n)} class="px-4 py-2 border border-line text-navy hover:text-magenta transition-colors">{n}</a>
      )
    )}
    {currentPage < lastPage && (
      <a href={pageUrl(currentPage + 1)} rel="next" class="px-4 py-2 border border-line text-navy hover:text-magenta transition-colors">次へ →</a>
    )}
  </nav>
)}
