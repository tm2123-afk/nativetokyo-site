---
// 法人向け組織プレゼンス診断
// 3段階 × 各4問。配点 1pt / 2pt / 3pt。満点24pt。
// チャエン方式：結果はスコアと段階名のみ先に見せ、詳細は3項目フォーム入力後に表示する
const layers = [
  {
    id: 1,
    label: '段階1',
    name: '基本',
    note: '内容以前で減点されていないか',
    weight: 1,
    questions: [
      '来客対応・商談に出る社員の身だしなみについて、社内に共有された基準がある',
      '対外的な場に出る社員の服装が、シワ・汚れ・サイズ不適合なく保たれている',
      '見た目や所作について、社内で指摘し合える関係性がある',
      '採用面接に出る社員の印象が、応募者から見てどう映るかを検討したことがある',
    ],
  },
  {
    id: 2,
    label: '段階2',
    name: '印象の統一',
    note: '会社のイメージと一致しているか',
    weight: 2,
    questions: [
      '社員の見た目・振る舞いが、自社のブランドイメージと一致している',
      '役職や役割に応じた「ふさわしい見せ方」の目安が共有されている',
      '登壇・展示会・取材など対外の場での見せ方に、一貫性がある',
      '広報・営業など「会社の顔」となる社員の印象が、意図して設計されている',
    ],
  },
  {
    id: 3,
    label: '段階3',
    name: '信頼',
    note: '「任せたい」が生まれているか',
    weight: 3,
    questions: [
      '役員・経営層について、社外から「貫禄がある」と評されることがある',
      '初対面の商談で、相手が自然にこちらのペースに合わせる場面がある',
      '若手社員が顧客先で、年次に関わらず対等に扱われている',
      '提案内容を詳しく説明する前の段階で「御社に任せたい」と言われることがある',
    ],
  },
];

const totalMax = layers.reduce((s, l) => s + l.questions.length * l.weight, 0);
---

<div class="border border-line bg-white/50" id="diagnosis-app" data-total-max={totalMax}>

  <!-- STEP 1: イントロ -->
  <div id="diagnosis-intro" class="p-8 md:p-12 border-b border-line">
    <p class="label text-magenta mb-5">1分でわかる 組織の印象診断</p>
    <h2 class="font-mincho font-bold text-2xl md:text-3xl text-navy mb-5">組織の印象診断</h2>
    <p class="text-[15px] leading-loose text-ink/75 max-w-2xl">
      御社の社員は、取引先や応募者からどう見えているか。
      12の質問で、組織の状態を3つの段階から確認できます。所要時間は約1分です。
    </p>
  </div>

  <!-- STEP 2: 設問 -->
  <form id="diagnosis-form" class="p-8 md:p-12">
    {layers.map((layer) => (
      <fieldset class="mb-12 last:mb-0">
        <legend class="mb-6">
          <span class="label text-magenta block mb-1.5">{layer.label} — {layer.note}</span>
          <span class="font-mincho font-bold text-xl text-navy">{layer.name}</span>
          <span class="text-xs text-ink/45 ml-3">各{layer.weight}pt</span>
        </legend>

        <ul class="space-y-0 border-t border-line">
          {layer.questions.map((q, qi) => (
            <li class="border-b border-line">
              <label class="flex items-start gap-4 py-4 cursor-pointer group">
                <input
                  type="checkbox"
                  data-weight={layer.weight}
                  data-layer={layer.id}
                  name={`q-${layer.id}-${qi}`}
                  class="mt-1 w-[18px] h-[18px] accent-[#1B2A4A] shrink-0 cursor-pointer"
                />
                <span class="text-[15px] leading-relaxed text-ink/85 group-hover:text-navy transition-colors">
                  {q}
                </span>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>
    ))}

    <button
      type="submit"
      class="label px-12 py-4 bg-navy text-paper rounded-sm hover:bg-navy-soft transition-colors mt-10"
    >診断結果を見る</button>
  </form>

  <!-- STEP 3: 結果（スコアと段階名のみ。詳細は非表示） -->
  <div id="diagnosis-partial" class="hidden p-8 md:p-12 border-t border-line">
    <p class="label text-magenta mb-5">結果</p>

    <div class="flex items-baseline gap-4 mb-2">
      <span id="result-score" class="font-mincho font-extrabold text-[56px] leading-none text-navy">0</span>
      <span class="text-ink/45 text-lg">/ {totalMax} pt</span>
    </div>

    <h3 id="result-title" class="font-mincho font-bold text-2xl text-navy mt-6 mb-10"></h3>

    <div class="border-t border-line pt-8">
      <p class="text-[15px] leading-loose text-ink/75 max-w-2xl mb-7">
        この段階でやるべきことと、30項目の詳細チェックシートをお送りします。
      </p>

      <form
        id="diagnosis-lead-form"
        name="diagnosis-lead"
        method="POST"
        data-netlify="true"
        netlify-honeypot="lead-bot-field"
        class="max-w-md space-y-5"
      >
        <input type="hidden" name="form-name" value="diagnosis-lead" />
        <input type="hidden" name="score" id="lead-score-field" value="" />
        <input type="hidden" name="tier" id="lead-tier-field" value="" />
        <p class="hidden">
          <label>この項目は入力しないでください<input name="lead-bot-field" /></label>
        </p>

        <div>
          <label for="lead-company" class="block text-[13px] text-ink/60 tracking-wide mb-1.5">
            会社名 <span class="text-magenta">*</span>
          </label>
          <input
            id="lead-company" name="company" type="text" required
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none"
          />
        </div>
        <div>
          <label for="lead-name" class="block text-[13px] text-ink/60 tracking-wide mb-1.5">
            お名前 <span class="text-magenta">*</span>
          </label>
          <input
            id="lead-name" name="name" type="text" required
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none"
          />
        </div>
        <div>
          <label for="lead-email" class="block text-[13px] text-ink/60 tracking-wide mb-1.5">
            メールアドレス <span class="text-magenta">*</span>
          </label>
          <input
            id="lead-email" name="email" type="email" required
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none"
          />
        </div>

        <button
          type="submit"
          data-ga="diagnosis_lead_submit"
          class="label px-10 py-4 bg-magenta text-white rounded-sm hover:bg-[#B3145C] transition-colors"
        >詳しい診断結果を見る</button>
      </form>
    </div>
  </div>

  <!-- STEP 4: 詳細結果（フォーム送信後に表示） -->
  <div id="diagnosis-full" class="hidden p-8 md:p-12 border-t border-line">
    <p class="label text-magenta mb-5">詳細結果</p>

    <p id="result-body" class="text-[15px] leading-loose text-ink/80 max-w-2xl mb-10"></p>

    <div class="grid sm:grid-cols-3 gap-px bg-line border border-line mb-10 max-w-2xl">
      {layers.map((layer) => (
        <div class="bg-paper p-5">
          <p class="text-[11px] text-ink/50 tracking-wide mb-2">{layer.name}</p>
          <p class="font-mincho font-bold text-navy">
            <span data-result-layer={layer.id}>0</span>
            <span class="text-ink/40 text-sm"> / {layer.questions.length * layer.weight}</span>
          </p>
        </div>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row gap-5 sm:items-center">
      <a
        href="/contact"
        data-ga="cta_contact_click"
        data-ga-location="diagnosis_result"
        class="label px-10 py-[18px] bg-navy text-paper rounded-sm hover:bg-navy-soft transition-colors text-center"
      >研修について相談する</a>
      <button
        type="button"
        id="diagnosis-retry"
        class="text-sm text-navy border-b border-navy pb-0.5 w-fit"
      >もう一度診断する</button>
    </div>
  </div>
</div>

<script>
  const app = document.getElementById('diagnosis-app');
  const intro = document.getElementById('diagnosis-intro');
  const form = document.getElementById('diagnosis-form') as HTMLFormElement | null;
  const partial = document.getElementById('diagnosis-partial');
  const full = document.getElementById('diagnosis-full');
  const leadForm = document.getElementById('diagnosis-lead-form') as HTMLFormElement | null;
  const retry = document.getElementById('diagnosis-retry');

  if (app && form && partial && full && leadForm) {
    const totalMax = Number(app.dataset.totalMax || 24);

    const tiers = [
      {
        min: 0, max: 8,
        title: '内容以前で、評価を下げている可能性がある状態',
        body: '基本的な身だしなみや所作の段階で失点が起きている状態です。この段階の課題は、営業・採用・広報のすべてに影響します。逆に言えば、最も改善効果が出やすい領域でもあります。まず社内で基準を明文化するところから着手すべき段階です。',
      },
      {
        min: 9, max: 14,
        title: '悪くはないが、記憶に残っていない状態',
        body: '大きな失点はないものの、「印象が薄い」状態です。多くの企業がこの水準に留まります。ここから先は、個人の努力ではなく、役割ごとの基準を組織として決める段階になります。',
      },
      {
        min: 15, max: 19,
        title: '一部の社員では「任せたい」が生まれている状態',
        body: '特定の人物では信頼が発生しているものの、組織全体には広がっていない状態です。この段階の課題は属人化の解消です。誰か一人の資質に依存している状態を、再現できる基準に変える必要があります。',
      },
      {
        min: 20, max: 99,
        title: '組織として機能している状態',
        body: '提案内容を説明する前の段階で、信頼が生まれている優良な状態です。この水準の課題は維持と継承に移ります。基準が暗黙知のままだと、人の入れ替わりで急速に劣化します。定期的な確認の仕組みをご検討ください。',
      },
    ];

    let currentTotal = 0;
    let currentTier = tiers[0];
    const byLayer: Record<string, number> = { '1': 0, '2': 0, '3': 0 };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const boxes = form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
      currentTotal = 0;
      byLayer['1'] = 0; byLayer['2'] = 0; byLayer['3'] = 0;

      boxes.forEach((box) => {
        if (box.checked) {
          const w = Number(box.dataset.weight || 0);
          const l = box.dataset.layer || '0';
          currentTotal += w;
          if (byLayer[l] !== undefined) byLayer[l] += w;
        }
      });

      currentTier = tiers.find((t) => currentTotal >= t.min && currentTotal <= t.max) || tiers[0];

      const scoreEl = document.getElementById('result-score');
      const titleEl = document.getElementById('result-title');
      if (scoreEl) scoreEl.textContent = String(currentTotal);
      if (titleEl) titleEl.textContent = currentTier.title;

      const scoreField = document.getElementById('lead-score-field') as HTMLInputElement | null;
      const tierField = document.getElementById('lead-tier-field') as HTMLInputElement | null;
      if (scoreField) scoreField.value = `${currentTotal} / ${totalMax}`;
      if (tierField) tierField.value = currentTier.title;

      intro?.classList.add('hidden');
      form.classList.add('hidden');
      partial.classList.remove('hidden');
      partial.scrollIntoView({ behavior: 'smooth', block: 'start' });

      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'diagnosis_complete', {
          score: currentTotal, max: totalMax, tier: currentTier.title,
        });
      }
    });

    leadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = leadForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '送信中…'; }

      try {
        const formData = new FormData(leadForm);
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData as any).toString(),
        });
      } catch (err) {
        console.error('diagnosis lead submit failed', err);
      }

      const bodyEl = document.getElementById('result-body');
      if (bodyEl) bodyEl.textContent = currentTier.body;
      Object.keys(byLayer).forEach((l) => {
        const el = document.querySelector(`[data-result-layer="${l}"]`);
        if (el) el.textContent = String(byLayer[l]);
      });

      partial?.classList.add('hidden');
      full?.classList.remove('hidden');
      full?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'diagnosis_lead_captured', { tier: currentTier.title });
      }
    });

    retry?.addEventListener('click', () => {
      form.reset();
      leadForm.reset();
      full?.classList.add('hidden');
      partial?.classList.add('hidden');
      intro?.classList.remove('hidden');
      form.classList.remove('hidden');
      app.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
