---
const navItems = [
  { label: 'プレゼンス研修', href: '/service/presence' },
  { label: 'AI時代の人間力', href: '/service/ai-ningenryoku' },
  { label: 'よくある課題', href: '/works' },
  { label: '私たちについて', href: '/about' },
  { label: 'ブログ', href: '/blog' },
];
const current = Astro.url.pathname;
---

<header class="border-b border-line bg-paper sticky top-0 z-50">
  <div class="flex items-center justify-between px-6 md:px-16 py-6">
    <a href="/" class="font-mincho font-bold text-lg tracking-wide text-navy shrink-0">
      NATIVE<span class="text-magenta">TOKYO</span>
    </a>

    <nav class="hidden lg:flex gap-9 label" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
          class:list={[
            'transition-colors hover:text-navy',
            current.startsWith(item.href) ? 'text-navy' : 'text-ink/70',
          ]}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        data-ga="cta_contact_click"
        data-ga-location="header"
        class="hidden sm:inline-block label px-6 py-2.5 bg-[#E31C79] text-white rounded-sm hover:bg-[#B3145C] transition-colors"
      >お問い合わせ</a>

      <!-- モバイルナビ：JSなしのdetails/summaryで実装 -->
      <details class="lg:hidden relative">
        <summary class="p-2 -mr-2" aria-label="メニューを開く">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1B2A4A" stroke-width="1.5">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-full mt-3 w-60 bg-paper border border-line rounded-sm py-3 shadow-lg"
          aria-label="モバイルナビゲーション"
        >
          {navItems.map((item) => (
            <a href={item.href} class="block px-5 py-3 text-sm text-ink/80 hover:bg-line/40">{item.label}</a>
          ))}
          <a
            href="/contact"
            data-ga="cta_contact_click"
            data-ga-location="mobile_nav"
            class="block px-5 py-3 text-sm text-magenta font-medium border-t border-line mt-2 pt-4"
          >お問い合わせ</a>
        </nav>
      </details>
    </div>
  </div>
</header>
