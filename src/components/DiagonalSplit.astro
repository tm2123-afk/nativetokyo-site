---
interface Props {
  image: string;
  imageAlt: string;
  eyebrow: string;
  headline: string;
}
const { image, imageAlt, eyebrow, headline } = Astro.props;
---

<section class="diagonal-split" data-reveal>
  <div class="ds-photo">
    <img src={image} alt={imageAlt} width="700" height="900" loading="lazy" />
  </div>
  <div class="ds-color">
    <p class="label text-paper/80 mb-5">{eyebrow}</p>
    <p class="font-mincho font-extrabold text-[clamp(24px,3.2vw,38px)] leading-[1.6] text-paper">
      {headline}
    </p>
  </div>
</section>

<style>
  .diagonal-split {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    min-height: 420px;
  }
  @media (min-width: 768px) {
    .diagonal-split { grid-template-columns: 1.1fr 1fr; min-height: 520px; }
  }

  .ds-photo {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
  }
  .ds-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
  }

  .ds-color {
    position: relative;
    background: var(--color-magenta);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px 40px;
  }
  @media (min-width: 768px) {
    .ds-color {
      padding: 64px 64px;
      /* 斜めカットでフォトとの継ぎ目を作る（チラシの構図を踏襲） */
      clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%);
      margin-left: -6%;
    }
  }
</style>
