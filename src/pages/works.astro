---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import HashtagMarquee from '../components/HashtagMarquee.astro';
import GiantWord from '../components/GiantWord.astro';
import ScenarioCards from '../components/ScenarioCards.astro';
import Insignia from '../components/Insignia.astro';

const reasons = [
  {
    n: '01',
    title: '指摘するとハラスメントになる',
    body: '「その服装は違う」「姿勢が悪い」——上司が気づいていても、口に出せません。外見への言及はハラスメントを疑われる領域だからです。結果、誰も言わないまま本人だけが評価を下げ続けます。',
  },
  {
    n: '02',
    title: '担当する部署が存在しない',
    body: '会社のロゴやWebサイトには担当者がいます。しかし「社員がどう見えているか」を管理する部署は、ほとんどの企業にありません。最も顧客と接する部分が、誰の管轄でもない状態で放置されています。',
  },
  {
    n: '03',
    title: '損失が数字に出ない',
    body: '見せ方が原因で失注しても、報告書には「価格」「タイミング」と書かれます。機会損失は集計されないため、経営数値に現れません。問題として認識されないまま発生し続けます。',
  },
];
---

<Layout
  title="プロジェクト"
  description="実力や誠実さが相手に届いていない。その原因が「見せ方」にあると気づかれないまま放置されている現場の具体例をご紹介します。合同会社NATIVETOKYO。"
  path="/works"
  breadcrumbs={[{ name: 'プロジェクト', path: '/works' }]}
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow="PROJECT"
      title="こういう場面に、使われています。"
      lead="実力や誠実さが、相手に届いていない。その原因が「見せ方」にあると気づかれないまま放置されている現場を、数多く見てきました。"
    />

    <HashtagMarquee />

    <!-- なぜ放置されるのか -->
    <section class="relative px-6 md:px-16 py-24 bg-navy text-paper overflow-hidden">
      <Insignia class="hidden lg:block -top-32 -right-28 w-96 h-96 opacity-30" />

      <div class="relative z-10">
        <p class="label text-magenta mb-5">構造</p>
        <h2 class="font-mincho font-bold text-2xl md:text-3xl mb-4 leading-relaxed">
          社内では、誰も指摘できません。
        </h2>
        <p class="text-sm text-paper/70 leading-loose max-w-2xl mb-14">
          見た目や振る舞いの問題が放置される理由は、3つあります。
        </p>

        <div class="grid md:grid-cols-3 gap-px bg-paper/15 border border-paper/15" data-reveal-group>
          {reasons.map((r) => (
            <div class="bg-navy p-8" data-reveal>
              <span
                class="font-mincho text-3xl leading-none text-transparent mb-6 block"
                style="-webkit-text-stroke: 1px rgba(250,250,247,0.5);"
                aria-hidden="true"
              >{r.n}</span>
              <h3 class="font-bold text-[15px] mb-4 text-paper">{r.title}</h3>
              <p class="text-[13px] leading-loose text-paper/70">{r.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 具体的な場面 -->
    <section class="relative px-6 md:px-16 py-24 overflow-hidden">
      <GiantWord word="SCENE" class="-top-8 -right-8 opacity-50" />

      <div class="relative z-10">
        <p class="label text-magenta mb-5">シーン</p>
        <h2 class="font-mincho font-bold text-2xl md:text-3xl text-navy mb-14">
          こんな課題を、扱っています。
        </h2>

        <ScenarioCards />
      </div>
    </section>

    <!-- CTA -->
    <section class="px-6 md:px-16 py-24 border-t border-line bg-magenta text-paper">
      <h2 class="font-mincho font-bold text-2xl md:text-3xl mb-6 max-w-xl leading-relaxed">
        当てはまる場面はありましたか。
      </h2>
      <p class="text-sm text-paper/80 mb-10 max-w-lg leading-loose">
        現状がどの段階にあるかは、1分の診断で確認できます。
      </p>
      <a
        href="/service/presence#diagnosis"
        data-ga="cta_diagnosis_click"
        data-ga-location="works_cta"
        class="label px-10 py-[18px] bg-paper text-navy rounded-sm hover:opacity-90 transition-opacity inline-block"
      >組織の印象を診断する</a>
    </section>
  </main>

  <Footer />
</Layout>
