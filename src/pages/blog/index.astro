---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import HashtagMarquee from '../../components/HashtagMarquee.astro';
import GiantWord from '../../components/GiantWord.astro';
import BlogList from '../../components/BlogList.astro';
import { PAGE_SIZE } from './page/[page].astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---

<Layout
  title="ブログ"
  description="扱われ方・見せ方・対人コミュニケーションについて、行動科学の観点から具体策を書いています。合同会社NATIVETOKYO。"
  path="/blog"
  breadcrumbs={[{ name: 'ブログ', path: '/blog' }]}
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow="BLOG"
      title="見せ方の具体策"
      lead="抽象論ではなく、明日から実行できる具体まで分解して書いています。"
    />

    <HashtagMarquee />

    <section class="relative px-6 md:px-16 py-16 overflow-hidden">
      <GiantWord word="INSIGHT" class="-top-6 -right-10 opacity-50" />
      {posts.length === 0 ? (
        <p class="text-[15px] text-ink/70">記事を準備中です。</p>
      ) : (
        <BlogList posts={posts.slice(0, PAGE_SIZE)} currentPage={1} lastPage={lastPage} />
      )}
    </section>

    <CtaBand location="blog_index" />
  </main>

  <Footer />
</Layout>
