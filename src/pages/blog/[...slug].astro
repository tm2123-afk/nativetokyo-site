---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import Insignia from '../../components/Insignia.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      // 回遊とクロール導線のため、自分以外の新しい記事を最大3件渡す
      related: posts.filter((p) => p.id !== post.id).slice(0, 3),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: '松本大志',
    url: 'https://nativetokyo.jp/about',
  },
  publisher: {
    '@type': 'Organization',
    name: '合同会社NATIVETOKYO',
    logo: { '@type': 'ImageObject', url: 'https://nativetokyo.jp/logo.svg' },
  },
  mainEntityOfPage: `https://nativetokyo.jp/blog/${post.id}/`,
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  breadcrumbs={[
    { name: 'ブログ', path: '/blog' },
    { name: post.data.title, path: `/blog/${post.id}/` },
  ]}
  jsonLd={articleLd}
  ogImage={post.data.image ?? undefined}
>
  <Header />

  <main id="main">
    <!-- ヘッダー帯：紺背景で記事の格を出す -->
    <div class="relative bg-navy overflow-hidden">
      <Insignia class="hidden md:block -top-32 -right-24 w-80 h-80 opacity-40" />
      <div class="relative z-10 px-6 md:px-16 pt-16 pb-14 md:pt-24 md:pb-20 max-w-3xl">
        <time datetime={post.data.pubDate.toISOString()} class="text-xs text-paper/50 tracking-wide">
          {fmt(post.data.pubDate)}
        </time>
        <h1 class="font-mincho font-extrabold text-paper leading-[1.5] text-[clamp(26px,3.6vw,40px)] mt-4">
          {post.data.title}
        </h1>
      </div>
    </div>

    <article class="px-6 md:px-16 py-16 md:py-20">
      <div class="max-w-3xl">

        {post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            class="w-full aspect-[16/9] object-cover mb-14 border border-line"
            width="1200" height="675"
          />
        )}

        <div class="prose-nt">
          <Content />
        </div>

        <!-- 著者 -->
        <div class="mt-20 border border-line p-7 flex gap-5 items-start">
          <img src="/images/author.jpg" alt="松本大志" class="w-14 h-14 rounded-full object-cover shrink-0" width="56" height="56" />
          <div>
            <p class="font-bold text-navy text-[15px] mb-1.5">松本 大志</p>
            <p class="text-[13px] leading-loose text-ink/70">
              合同会社NATIVETOKYO 代表。行動科学に基づくプレゼンス設計を、法人向け研修として提供。
              <a href="/about" class="text-navy underline">プロフィール →</a>
            </p>
          </div>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="px-6 md:px-16 pb-16 md:pb-20">
        <div class="max-w-3xl">
          <p class="label text-magenta mb-5">READ NEXT</p>
          <ul class="border-t border-line">
            {related.map((p) => (
              <li class="border-b border-line">
                <a
                  href={`/blog/${p.id}/`}
                  class="block py-6 group transition-transform hover:translate-x-2"
                  data-ga="related_post_click"
                  data-ga-location={post.id}
                >
                  <time datetime={p.data.pubDate.toISOString()} class="text-xs text-ink/50 tracking-wide">
                    {fmt(p.data.pubDate)}
                  </time>
                  <p class="font-mincho font-bold text-[17px] text-navy mt-2 group-hover:text-magenta transition-colors">
                    {p.data.title}
                  </p>
                </a>
              </li>
            ))}
          </ul>
          <a
            href="/blog"
            class="inline-block mt-8 text-sm text-navy border-b border-navy pb-0.5"
            data-ga="to_blog_index"
            data-ga-location={post.id}
          >記事一覧を見る →</a>
        </div>
      </section>
    )}

    <CtaBand location="blog_post" />
  </main>

  <Footer />
</Layout>

<style is:global>
  .prose-nt { font-size: 16px; line-height: 2.05; color: rgba(28,28,28,0.85); }
  .prose-nt h2 {
    font-family: var(--font-mincho); font-weight: 700; font-size: 24px;
    color: var(--color-navy); margin: 64px 0 20px; padding: 4px 0 14px 18px;
    border-bottom: 1px solid var(--color-line);
    border-left: 4px solid var(--color-magenta);
  }
  .prose-nt h3 {
    font-weight: 700; font-size: 17px; color: var(--color-navy); margin: 40px 0 14px;
  }
  .prose-nt p { margin: 20px 0; }
  .prose-nt ul, .prose-nt ol { margin: 20px 0; padding-left: 1.4em; }
  .prose-nt li { margin: 10px 0; }
  .prose-nt ol { list-style: decimal; }
  .prose-nt ul { list-style: disc; }
  .prose-nt strong { font-weight: 700; color: var(--color-navy); }
  .prose-nt a { color: var(--color-navy); text-decoration: underline; text-underline-offset: 3px; }
  .prose-nt a:hover { color: var(--color-magenta); }

  .prose-nt pre {
    background: var(--color-navy);
    color: rgba(250, 250, 247, 0.92);
    padding: 24px 26px;
    border-radius: 4px;
    overflow-x: auto;
    margin: 28px 0;
    font-size: 14px;
    line-height: 1.85;
    font-weight: 400;
  }
  .prose-nt pre code {
    font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
    background: none;
    padding: 0;
    color: inherit;
    font-weight: 400;
  }
  .prose-nt code {
    font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
    font-size: 0.9em;
    background: var(--color-navy);
    color: rgba(250, 250, 247, 0.92);
    padding: 2px 7px;
    border-radius: 3px;
  }
  .prose-nt blockquote {
    border-left: 3px solid var(--color-magenta);
    padding: 4px 0 4px 24px;
    margin: 28px 0;
    color: rgba(28,28,28,0.7);
    font-size: 15px;
  }
  .prose-nt blockquote p { margin: 8px 0; }
  .prose-nt table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 14px;
  }
  .prose-nt th, .prose-nt td {
    border: 1px solid var(--color-line);
    padding: 10px 14px;
    text-align: left;
  }
  .prose-nt th { background: var(--color-paper); font-weight: 700; color: var(--color-navy); }
</style>
