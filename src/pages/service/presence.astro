---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import DiagonalSplit from '../../components/DiagonalSplit.astro';
import Diagnosis from '../../components/Diagnosis.astro';

const faqs = [
  { q: '何名から実施できますか？', a: '少人数の経営層向けから、数十名規模の階層別研修まで対応しています。人数と課題に応じて構成を変えるため、まずはご相談ください。' },
  { q: '単発のセミナーだけでも依頼できますか？', a: '可能です。多くの企業様が単発のセミナーから開始し、効果を確認した上で実践・ガイドライン策定へ進まれます。' },
  { q: '「見た目の指導」という理解で合っていますか？', a: '外見はあくまで一部です。姿勢・声・視線といった言葉以外の情報全体を扱うため、服装指導だけを行うプログラムではありません。' },
  { q: 'オンライン研修に対応していますか？', a: '対応可能です。ただし非言語情報を扱う性質上、対面の方が精度が上がる領域があるため、初回は対面を推奨しています。' },
  { q: '費用はどのくらいですか？', a: '実施形式・回数・人数によって変動します。単発セミナーから年間パートナーシップまで幅がありますので、お問い合わせ時に課題感をお聞かせいただければ、個別にお見積りをご案内します。' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="プレゼンスマネジメント研修｜法人向け"
  description="姿勢・声・視線・間・服装。非言語情報の設計を通じて、実力が正しく伝わる状態をつくる法人向けプレゼンスマネジメント研修。組織単位で基準を揃え、属人化させずに定着させます。"
  path="/service/presence"
  breadcrumbs={[{ name: 'プレゼンスマネジメント研修', path: '/service/presence' }]}
  jsonLd={faqLd}
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow="PRESENCE MANAGEMENT"
      title="「なんとなく軽く扱われる」を、社内から無くす。"
      lead="実力があるのに、それが相手に伝わっていない社員はいませんか。プレゼンスマネジメント研修では、見た目・声・姿勢・視線といった「言葉以外の情報」を扱います。感覚的なアドバイスではなく、3段階の診断で現状を数値化し、どこから直せば効果が出るかを明確にします。"
    />

    <!-- 診断：ヒーロー直後、独立ブロックとして最上部に配置 -->
    <section id="diagnosis" class="px-6 md:px-16 py-20 md:py-24 bg-navy scroll-mt-20">
      <div class="text-center mb-10">
        <p class="label text-white/70 mb-3">まずはここから・所要時間 約1分</p>
        <h2 class="font-mincho font-bold text-2xl md:text-3xl text-white">
          貴社は、今どの段階にいますか？
        </h2>
      </div>
      <Diagnosis />
    </section>

    <!-- 課題 -->
    <section class="px-6 md:px-16 py-20">
      <p class="label text-magenta mb-5">SYMPTOMS</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-10">こんな課題に効きます</h2>
      <ul class="grid sm:grid-cols-2 gap-x-12 gap-y-5 max-w-4xl">
        {[
          '実力のある若手・中堅が、社内外で正当に扱われていない',
          '会議で発言が流され、意思決定に反映されない',
          '営業の提案内容は良いのに、受注に繋がらない',
          '管理職の指示が、なぜか現場に浸透しない',
          '評価制度が成果のみで、「伝わり方」を扱えていない',
          '新任リーダーが役割にふさわしい存在感を出せていない',
        ].map((item) => (
          <li class="flex gap-3 text-[15px] leading-loose text-ink/80 border-b border-line pb-4">
            <span class="text-magenta shrink-0">—</span>{item}
          </li>
        ))}
      </ul>
    </section>

    <!-- 3段階（診断の考え方） -->
    <section class="px-6 md:px-16 py-20 border-t border-line">
      <p class="label text-magenta mb-5">診断の考え方</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-12">今どの段階にいるかで、やるべきことは変わります</h2>
      <div class="grid md:grid-cols-3 gap-px bg-line border border-line">
        {[
          { t: '段階1｜内容以前で減点されている', d: '身だしなみや所作の基準が揃っておらず、話の中身を聞いてもらう前に評価が下がっている状態。最も改善効果が出やすい領域です。' },
          { t: '段階2｜印象が弱い', d: '違和感はないが、記憶に残らない状態。多くの企業がここに留まります。' },
          { t: '段階3｜「任せたい」が生まれている', d: '提案を詳しく説明する前に、信頼が発生している状態。この段階の社員が何人いるかが組織の力になります。' },
        ].map((x) => (
          <div class="bg-paper p-7">
            <h3 class="font-bold text-navy mb-3 text-[15px]">{x.t}</h3>
            <p class="text-[13px] leading-loose text-ink/70">{x.d}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-ink/50 mt-6">※ 各段階の具体的な改善方法は、対面でのご提案時にご説明します。</p>
    </section>

    <DiagonalSplit
      image="/images/seminar-1.jpg"
      imageAlt="研修風景"
      eyebrow="WHY NOW"
      headline="扱われ方は、能力ではなく設計で決まる。単発の研修ではなく、組織の基準として定着させます。"
    />

    <!-- FAQ -->
    <section class="px-6 md:px-16 py-20 border-t border-line">
      <p class="label text-magenta mb-5">FAQ</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-10">よくあるご質問</h2>
      <div class="max-w-3xl border-t border-line">
        {faqs.map((f) => (
          <details class="border-b border-line group">
            <summary class="py-6 flex justify-between items-start gap-6 text-[15px] font-medium text-navy">
              {f.q}
              <span class="text-magenta shrink-0 text-xl leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="pb-6 text-sm leading-loose text-ink/70">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <CtaBand location="presence_page" />
  </main>

  <Footer />
</Layout>
