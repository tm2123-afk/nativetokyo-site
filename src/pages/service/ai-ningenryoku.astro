---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import DiagonalSplit from '../../components/DiagonalSplit.astro';
import HashtagMarquee from '../../components/HashtagMarquee.astro';

const elements = [
  { n: '01', t: 'データを読む', d: '何が起きているかを、数字と事実で把握する。AIが出力した結果を鵜呑みにせず、前提を疑う視点を持つ。' },
  { n: '02', t: '構造で分析する', d: '事象を要素に分解し、因果と相関を切り分ける。AIに問いを投げる前に、問い自体を設計できる状態にする。' },
  { n: '03', t: '原理から考える', d: '前例やテンプレートではなく、第一原理に立ち返って組み立て直す。AIが最も苦手とする領域。' },
  { n: '04', t: '経験を蓄積する', d: '身体を通した実体験の量。他者と対面した回数と質が、判断の精度を決める。' },
  { n: '05', t: '他者を感知する', d: '相手が何を感じ、何を言わずにいるかを読む。非言語情報から仮説を立てる技術。' },
  { n: '06', t: '判断する', d: '正解のない状況で、責任を持って決める。最終的に人にしか担えない領域。' },
];
---

<Layout
  title="AI時代の人間力研修｜法人向け"
  description="分析も生成もAIが担う時代に、人に残る価値とは何か。抽象的な「共感力が大事」で終わらせず、再現可能な行動レベルまで分解して設計する法人向け研修です。"
  path="/service/ai-ningenryoku"
  breadcrumbs={[{ name: 'AI時代の人間力研修', path: '/service/ai-ningenryoku' }]}
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow="HUMAN SKILLS IN THE AI ERA"
      title="「共感力が大事」で、止まっていませんか。"
      lead="AI時代の人間力という言葉は広く語られていますが、多くは抽象論で終わっています。この研修では、人に残る能力を6つの要素に分解し、それぞれを行動レベルの具体策まで落とし込みます。"
    />

    <HashtagMarquee />

    <!-- THE PROBLEM：navy全面帯 -->
    <section class="px-6 md:px-16 py-24 bg-navy" data-reveal>
      <p class="label text-magenta mb-5">THE PROBLEM</p>
      <h2 class="font-mincho font-bold text-3xl md:text-4xl text-paper mb-8 max-w-2xl leading-relaxed">
        抽象論は、現場で再現できない。
      </h2>
      <p class="text-[15px] leading-loose text-paper/75 max-w-3xl">
        「これからは共感力の時代」「人間にしかできないことをやろう」——
        こうしたメッセージは正しくても、翌日から何をすればいいのかが分かりません。
        結果として、研修を実施しても行動が変わらない。
        NATIVETOKYOの研修は、行動科学のフレームで「明日から実行できる具体」まで分解することを設計原則にしています。
      </p>
    </section>

    <section class="px-6 md:px-16 py-20" data-reveal>
      <p class="label text-magenta mb-5">6 ELEMENTS</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-12">人に残る6つの要素</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line border border-line">
        {elements.map((x) => (
          <div class="bg-paper p-7 relative overflow-hidden">
            <span class="absolute top-2 right-2 font-mincho text-[80px] leading-none text-navy/6" aria-hidden="true">{x.n}</span>
            <h3 class="font-bold text-navy mb-3 relative z-10">{x.t}</h3>
            <p class="text-[13px] leading-loose text-ink/70 relative z-10">{x.d}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-ink/50 mt-6 max-w-3xl leading-relaxed">
        ※ この6要素の整理は、AI時代に求められる能力についての業界の議論を踏まえ、NATIVETOKYOが研修用に再構成したものです。
      </p>
    </section>

    <!-- DiagonalSplit：navy基調 -->
    <DiagonalSplit
      image="/images/seminar-1.jpg"
      imageAlt="研修実施の様子"
      eyebrow="APPROACH"
      headline="プレゼンス研修との関係。6要素のうち「他者を感知する」「判断する」は、非言語情報の設計と直接つながります。"
    />

    <section class="px-6 md:px-16 py-20" data-reveal>
      <p class="text-[15px] leading-loose text-ink/75 max-w-3xl mb-8">
        AI時代の人間力研修を導入の入口とし、より実践的な訓練としてプレゼンス研修へ展開するケースが多くなっています。
      </p>
      <a href="/service/presence" class="inline-block text-sm text-navy border-b border-navy pb-0.5">
        プレゼンス研修を見る →
      </a>
    </section>

    <CtaBand location="ai_ningenryoku_page" />
  </main>

  <Footer />
</Layout>
