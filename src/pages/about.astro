---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import MagentaQuote from '../components/MagentaQuote.astro';
import Insignia from '../components/Insignia.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import HashtagMarquee from '../components/HashtagMarquee.astro';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '松本大志',
  alternateName: 'Taishi Matsumoto',
  jobTitle: '代表',
  worksFor: { '@type': 'Organization', name: '合同会社NATIVETOKYO', url: 'https://nativetokyo.jp' },
  knowsAbout: ['プレゼンスマネジメント', '対人コミュニケーション', '行動科学', '組織開発'],
  url: 'https://nativetokyo.jp/about',
};
---

<Layout
  title="私たちについて"
  description="合同会社NATIVETOKYO 代表 松本大志。行動科学に基づく対人力学とプレゼンス設計を、法人向け研修として提供しています。会社概要と代表プロフィール。"
  path="/about"
  breadcrumbs={[{ name: '私たちについて', path: '/about' }]}
  jsonLd={personLd}
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow="ABOUT"
      title="扱われ方は、設計できる。"
      lead="NATIVETOKYOは、対人コミュニケーションにおける「本音」と「行動」の非対称性を研究し、それを再現可能な技術として法人向けに提供している会社です。"
    />

    <HashtagMarquee tags={['松本大志', 'NATIVETOKYO', '行動科学', '対人力学', 'プレゼンス設計', '組織開発', '法人研修']} />

    <!-- 事業の考え方 -->
    <section class="px-6 md:px-16 py-20" data-reveal>
      <p class="label text-magenta mb-5">PHILOSOPHY</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-8">なぜ「見せ方」なのか</h2>
      <div class="max-w-3xl space-y-6 text-[15px] leading-loose text-ink/80">
        <p>
          人が発する情報の多くは、本音そのものではなく「その場に適応するための行動」です。
          表面的な傾聴だけでは、相手の真のニーズには辿り着けません。
        </p>
        <p>
          同時に、こちら側が発している情報も同じ構造を持っています。
          実力や誠実さは、そのままでは相手に届きません。姿勢・声・視線・間といった非言語情報を通じて、
          はじめて「そういう人だ」と認識されます。
        </p>
        <p>
          この非対称性を理解し、意図的に設計すること。それがNATIVETOKYOの扱う領域です。
          精神論でも、テクニック集でもなく、行動科学のフレームで再現可能にすることを重視しています。
        </p>
      </div>
    </section>

    <MagentaQuote
      quote="実力や誠実さは、そのままでは相手に届かない。姿勢・声・視線・間を通じて、はじめて「そういう人だ」と認識される。"
      attribution="NATIVETOKYO PHILOSOPHY"
    />

    <!-- 代表：背景色＋Insignia -->
    <section class="px-6 md:px-16 py-20 bg-paper relative overflow-hidden" data-reveal>
      <Insignia class="absolute -bottom-32 -right-32 w-[500px] h-[500px] opacity-10" />
      <div class="relative z-10">
        <p class="label text-magenta mb-5">REPRESENTATIVE</p>
        <h2 class="font-mincho font-bold text-2xl text-navy mb-12">代表プロフィール</h2>

        <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16 max-w-4xl">
          <div class="photo-duo aspect-[3/4] border border-line" data-reveal>
          <img
            src="/images/about-main.jpg"
            alt="松本大志"
            class="w-full h-full object-cover object-top"
            width="700" height="933"
          />
        </div>

        <div>
          <p class="font-mincho font-bold text-xl text-navy mb-1">松本 大志</p>
          <p class="text-sm text-ink/60 mb-8">Taishi Matsumoto ／ 合同会社NATIVETOKYO 代表</p>

          <div class="space-y-5 text-[15px] leading-loose text-ink/80">
            <p>
              聖光学院卒業後、ロンドン芸術大学にてファッションPRを修学。
              その後、Wharton School、University of Michigan にてコミュニケーション戦略・行動科学を学ぶ。
            </p>
            <p>
              ロンドン滞在中、マイノリティとして長期の孤立を経験。
              自分でも言語化できていなかった感情を先に言語化されたことで状況が変わった経験から、
              対人コミュニケーションにおける「理解される／されない」の構造に関心を持つ。
            </p>
            <p>
              帰国後、個人向けのコンサルティングを中心に活動。
              延べ多数のクライアントに対し、対人関係・ビジネスシーンでのプレゼンス設計を支援してきた。
              現在は、その知見を組織単位で再現可能にする法人向け研修へ展開している。
            </p>
          </div>

          <!-- 実績数値プレースホルダ -->
          <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 gap-px bg-line border border-line">
            {[
              { n: '準備中', l: '個人セッション実績' },
              { n: '準備中', l: '活動年数' },
              { n: '準備中', l: '法人導入' },
            ].map((s) => (
              <div class="bg-paper p-5 text-center">
                <p class="font-mincho font-bold text-lg text-navy">{s.n}</p>
                <p class="text-[11px] text-ink/55 mt-1.5">{s.l}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      </div>
    </section>

    <!-- 登壇・研修風景：navy背景 -->
    <section class="px-6 md:px-16 py-20 bg-navy" data-reveal>
      <p class="label text-magenta mb-5">IN ACTION</p>
      <h2 class="font-mincho font-bold text-2xl text-paper mb-10">研修・セミナーの様子</h2>
      <div class="grid sm:grid-cols-2 gap-12 md:gap-16 max-w-6xl">
        <div data-reveal>
          <PhotoCollage
            image="/images/seminar-1.jpg"
            imageAlt="法人向け研修の様子"
            variant="left"
          />
        </div>
        <div data-reveal>
          <PhotoCollage
            image="/images/about-sub.jpg"
            imageAlt="登壇の様子"
            variant="right"
          />
        </div>
      </div>
    </section>

    <!-- 会社概要 -->
    <section class="px-6 md:px-16 py-20" data-reveal>
      <p class="label text-magenta mb-5">COMPANY</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-10">会社概要</h2>
      <dl class="max-w-3xl border-t border-line">
        {[
          ['商号', '合同会社NATIVETOKYO（NATIVETOKYO LLC.）'],
          ['代表', '松本 大志'],
          ['所在地', '〒150-0045 東京都渋谷区神泉町10-15'],
          ['連絡先', 'info@nativetokyo.jp'],
          ['事業内容', '法人向け研修事業／コミュニケーション領域のコンサルティング'],
        ].map(([k, v]) => (
          <div class="grid sm:grid-cols-[180px_1fr] gap-2 sm:gap-6 py-5 border-b border-line">
            <dt class="text-[13px] text-ink/55 tracking-wide">{k}</dt>
            <dd class="text-[15px] text-ink/85">{v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <CtaBand location="about_page" />
  </main>

  <Footer />
</Layout>
