---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import MagentaQuote from '../components/MagentaQuote.astro';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '松本大志',
  alternateName: 'Taishi Matsumoto',
  jobTitle: '代表',
  worksFor: { '@type': 'Organization', name: '合同会社NATIVETOKYO', url: 'https://nativetokyo.jp' },
  knowsAbout: ['プレゼンスマネジメント', '対人コミュニケーション', '行動科学', '組織開発'],
  url: 'https://nativetokyo.jp/about',
};
---

<Layout
  title="私たちについて"
  description="合同会社NATIVETOKYO 代表 松本大志。行動科学にもとづく見せ方の設計を、法人向け研修として提供しています。会社概要と代表プロフィール。"
  path="/about"
  breadcrumbs={[{ name: '私たちについて', path: '/about' }]}
  jsonLd={personLd}
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow="ABOUT"
      title="見せ方は、感覚ではなく技術です。"
      lead="NATIVETOKYOは、対人コミュニケーションを感覚論で終わらせず、行動科学の知見にもとづいた再現可能な技術として提供している会社です。"
    />

    <!-- 事業の考え方 -->
    <section class="px-6 md:px-16 py-20">
      <p class="label text-magenta mb-5">PHILOSOPHY</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-8">なぜ「見せ方」なのか</h2>
      <div class="max-w-3xl space-y-6 text-[15px] leading-loose text-ink/80">
        <p>
          どれだけ真面目に取り組んでも、どれだけ実力があっても、
          それが相手に伝わらなければ評価は変わりません。
        </p>
        <p>
          姿勢、声、視線、服装。人はこうした言葉以外の情報から、
          相手がどういう人かを短時間で判断しています。これは避けられない仕組みであり、
          だからこそ設計する価値があります。
        </p>
        <p>
          私たちが扱うのは、話し方のテクニック集ではありません。
          なぜその印象が生まれるのかを構造から理解し、
          組織として同じ基準を持てる状態をつくることです。
        </p>
      </div>
    </section>

    <MagentaQuote
      quote="実力があることと、実力があるように見えることは、別のスキルです。後者は、教えることができます。"
      attribution="NATIVETOKYO"
    />

    <!-- 代表 -->
    <section class="px-6 md:px-16 py-20 border-t border-line">
      <p class="label text-magenta mb-5">REPRESENTATIVE</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-12">代表プロフィール</h2>

      <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16 max-w-4xl">
        <div class="photo-duo aspect-[3/4] border border-line" data-reveal>
          <img
            src="/images/about-main.jpg"
            alt="松本大志"
            class="w-full h-full object-cover object-top"
            width="700" height="933"
          />
        </div>

        <div>
          <p class="font-mincho font-bold text-xl text-navy mb-1">松本 大志</p>
          <p class="text-sm text-ink/60 mb-8">Taishi Matsumoto ／ 合同会社NATIVETOKYO 代表</p>

          <div class="space-y-5 text-[15px] leading-loose text-ink/80">
            <p>
              聖光学院卒業後、University of the Arts London にてファッションPRを修学。
              その後、Wharton School、University of Michigan にてコミュニケーション戦略・行動科学を学ぶ。
            </p>
            <p>
              ロンドン滞在中、マイノリティとして長期の孤立を経験。
              自分でも言語化できていなかった感情を先に言語化されたことで状況が変わった経験から、
              対人コミュニケーションにおける「理解される／されない」の構造に関心を持つ。
            </p>
            <p>
              帰国後はエグゼクティブ層を対象とした対人戦略コンサルティングを中心に活動。
              現在は、その知見を組織単位で再現可能にする法人研修へ展開している。
            </p>
          </div>

          <!-- 実績数値プレースホルダ -->
          <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 gap-px bg-line border border-line">
            {[
              { n: '準備中', l: '個人セッション実績' },
              { n: '準備中', l: '活動年数' },
              { n: '準備中', l: '法人導入' },
            ].map((s) => (
              <div class="bg-paper p-5 text-center">
                <p class="font-mincho font-bold text-lg text-navy">{s.n}</p>
                <p class="text-[11px] text-ink/55 mt-1.5">{s.l}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 登壇・研修風景 -->
    <section class="px-6 md:px-16 py-20 border-t border-line">
      <p class="label text-magenta mb-5">IN ACTION</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-10">研修・セミナーの様子</h2>
      <div class="grid sm:grid-cols-2 gap-6" data-reveal-group>
        <div class="photo-duo aspect-[3/2] border border-line" data-reveal>
          <img
            src="/images/seminar-1.jpg"
            alt="法人向け研修の様子"
            class="w-full h-full object-cover"
            width="800" height="533" loading="lazy"
          />
        </div>
        <div class="photo-duo aspect-[3/2] border border-line" data-reveal>
          <img
            src="/images/about-sub.jpg"
            alt="登壇の様子"
            class="w-full h-full object-cover"
            width="800" height="533" loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 会社概要 -->
    <section class="px-6 md:px-16 py-20 border-t border-line">
      <p class="label text-magenta mb-5">COMPANY</p>
      <h2 class="font-mincho font-bold text-2xl text-navy mb-10">会社概要</h2>
      <dl class="max-w-3xl border-t border-line">
        {[
          ['商号', '合同会社NATIVETOKYO（NATIVETOKYO LLC.）'],
          ['代表', '松本 大志'],
          ['所在地', '〒150-0045 東京都渋谷区神泉町10-15'],
          ['連絡先', 'info@nativetokyo.jp'],
          ['事業内容', '法人向け研修事業／コミュニケーション領域のコンサルティング'],
        ].map(([k, v]) => (
          <div class="grid sm:grid-cols-[180px_1fr] gap-2 sm:gap-6 py-5 border-b border-line">
            <dt class="text-[13px] text-ink/55 tracking-wide">{k}</dt>
            <dd class="text-[15px] text-ink/85">{v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <CtaBand location="about_page" />
  </main>

  <Footer />
</Layout>
