---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="お問い合わせ"
  description="法人向け研修のご相談・お見積りはこちらから。組織の規模と課題に合わせてご提案します。合同会社NATIVETOKYO。"
  path="/contact"
  breadcrumbs={[{ name: 'お問い合わせ', path: '/contact' }]}
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow="CONTACT"
      title="お問い合わせ"
      lead="研修のご相談、お見積り、その他ご質問はこちらから。通常2営業日以内にご返信します。"
    />

    <section class="px-6 md:px-16 py-16">
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks"
        class="max-w-2xl space-y-8"
        data-ga="form_start"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>この項目は入力しないでください<input name="bot-field" /></label>
        </p>

        <div>
          <label for="company" class="block text-[13px] text-ink/60 tracking-wide mb-2">
            会社名 <span class="text-magenta">*</span>
          </label>
          <input
            id="company" name="company" type="text" required
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none"
          />
        </div>

        <div>
          <label for="name" class="block text-[13px] text-ink/60 tracking-wide mb-2">
            ご担当者名 <span class="text-magenta">*</span>
          </label>
          <input
            id="name" name="name" type="text" required
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none"
          />
        </div>

        <div>
          <label for="email" class="block text-[13px] text-ink/60 tracking-wide mb-2">
            メールアドレス <span class="text-magenta">*</span>
          </label>
          <input
            id="email" name="email" type="email" required
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none"
          />
        </div>

        <div>
          <label for="topic" class="block text-[13px] text-ink/60 tracking-wide mb-2">
            ご関心のある領域
          </label>
          <select
            id="topic" name="topic"
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none"
          >
            <option value="presence">プレゼンス研修</option>
            <option value="ai_ningenryoku">AI時代の人間力研修</option>
            <option value="both">両方／どちらか分からない</option>
            <option value="other">その他</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-[13px] text-ink/60 tracking-wide mb-2">
            ご相談内容
          </label>
          <textarea
            id="message" name="message" rows="6"
            placeholder="現在の課題感、想定人数、実施時期など、分かる範囲でお書きください。"
            class="w-full border border-line bg-white/60 px-4 py-3 text-[15px] focus:border-navy outline-none resize-y"
          ></textarea>
        </div>

        <p class="text-xs text-ink/55 leading-relaxed">
          ご入力いただいた個人情報は、お問い合わせへの対応のみに利用します。詳しくは
          <a href="/privacy" class="underline hover:text-navy">プライバシーポリシー</a>をご確認ください。
        </p>

        <button
          type="submit"
          data-ga="form_submit"
          data-ga-location="contact_page"
          class="label px-12 py-4 bg-navy text-paper rounded-sm hover:bg-navy-soft transition-colors"
        >送信する</button>
      </form>
    </section>
  </main>

  <Footer />
</Layout>
