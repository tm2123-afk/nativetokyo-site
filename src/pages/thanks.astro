---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="送信完了"
  description="お問い合わせありがとうございます。"
  path="/thanks"
  noindex
>
  <Header />
  <main id="main" class="px-6 md:px-16 py-32 min-h-[50vh]">
    <p class="label text-magenta mb-5">SENT</p>
    <h1 class="font-mincho font-extrabold text-navy text-3xl mb-6">送信が完了しました。</h1>
    <p class="text-[15px] leading-loose text-ink/75 max-w-xl mb-10">
      お問い合わせいただきありがとうございます。内容を確認のうえ、通常2営業日以内にご返信します。
    </p>
    <a href="/" class="text-sm text-navy border-b border-navy pb-0.5">トップへ戻る →</a>
  </main>
  <Footer />
</Layout>
